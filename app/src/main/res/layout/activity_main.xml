<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0e0e1a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#0e0e1a"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#c9a227"
            android:text="Q"
            android:textSize="22sp"
            android:gravity="center"
            android:textColor="#0e0e1a"
            android:textStyle="bold"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QUEST LOG" android:textColor="#f4e4bc" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PIXEL RPG  +  TODO" android:textColor="#c9a227" android:textSize="11sp"/>
        </LinearLayout>

        <TextView android:id="@+id/rankBadge" android:layout_width="44dp" android:layout_height="44dp" android:background="#5a5a6a" android:text="E" android:textColor="#fff" android:textSize="18sp" android:textStyle="bold" android:gravity="center"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <!-- Hero Card -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#1a1433" android:layout_margin="12dp" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:text="H" android:textSize="28sp" android:layout_width="56dp" android:layout_height="56dp" android:background="#2a2440" android:gravity="center" android:textColor="#c9a227" android:textStyle="bold"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HERO  +  VIT BHOPAL" android:textColor="#c9a227" android:textSize="9sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/heroLevel" android:text="LV.1  +  0 XP" android:textColor="#f4e4bc" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/rankLabel" android:text="E - Novice" android:textColor="#f4e4bc" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/xpLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 100 XP -&gt; D" android:textColor="#c9a227" android:textSize="10sp" android:layout_marginTop="12dp"/>
        <ProgressBar android:id="@+id/xpBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="14dp" android:max="100" android:progress="6" android:layout_marginTop="6dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="E 0 - D 100 - C 300 - B 600 - A 1000 - S 1600" android:textColor="#f4e4bc" android:textSize="9sp" android:layout_marginTop="8dp"/>
        <LinearLayout android:id="@+id/badgesRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"/>
    </LinearLayout>

    <!-- Add Quest -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#f4e4bc" android:layout_marginLeft="12dp" android:layout_marginRight="12dp" android:padding="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEW QUEST  -  EXP = LV x 10" android:textColor="#1a1433" android:textSize="9sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <EditText android:id="@+id/questInput" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#ffffff" android:hint="Enter quest..." android:textColor="#1a1433" android:textColorHint="#8a7a5a" android:paddingLeft="12dp" android:paddingRight="12dp" android:textSize="14sp" android:singleLine="true" android:inputType="text"/>
            <TextView android:id="@+id/addBtn" android:layout_width="wrap_content" android:layout_height="48dp" android:text="+ ADD" android:textColor="#0e0e1a" android:background="#c9a227" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp" android:layout_marginLeft="8dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DIFFICULTY - 1 EASY  -&gt;  10 BOSS" android:textColor="#1a1433" android:textSize="9sp" android:layout_marginTop="12dp"/>
        <SeekBar android:id="@+id/diffSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="9" android:progress="4" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/diffLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LV. 5  -&gt;  +50 XP" android:textColor="#0e0e1a" android:background="#c9a227" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- Filter -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_margin="12dp">
        <TextView android:id="@+id/tabAll" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="ALL" android:textSize="10sp" android:textStyle="bold" android:background="#c9a227" android:textColor="#0e0e1a" android:gravity="center" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/tabActive" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="ACTIVE" android:textSize="10sp" android:background="#2a2440" android:textColor="#f4e4bc" android:gravity="center" android:layout_marginLeft="6dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/tabDone" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="CLEARED" android:textSize="10sp" android:background="#2a2440" android:textColor="#f4e4bc" android:gravity="center" android:layout_marginLeft="6dp" android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="12dp" android:paddingRight="12dp" android:clipToPadding="false" android:nestedScrollingEnabled="false"/>

    </LinearLayout>
    </ScrollView>

</LinearLayout>