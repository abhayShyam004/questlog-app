<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f0f4ff">

    <!-- Status bar — like Duolingo top: flag / streak / gems / hearts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#ffffff"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:elevation="2dp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="32dp" android:layout_height="32dp" android:background="#c9a227" android:text="Q" android:textColor="#0e0e1a" android:textSize="16sp" android:textStyle="bold" android:gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JP" android:textColor="#1a1433" android:textSize="9sp" android:textStyle="bold" android:background="#e8f0ff" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginLeft="6dp"/>
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="F" android:textColor="#ff9600" android:textSize="14sp" android:textStyle="bold" android:background="#fff4e6" android:paddingLeft="7dp" android:paddingRight="7dp" android:paddingTop="4dp" android:paddingBottom="4dp"/>
            <TextView android:id="@+id/streakTop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#ff9600" android:textSize="14sp" android:textStyle="bold" android:layout_marginLeft="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginLeft="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G" android:textColor="#1cb0f6" android:textSize="14sp" android:textStyle="bold" android:background="#e6f6ff" android:paddingLeft="7dp" android:paddingRight="7dp" android:paddingTop="4dp" android:paddingBottom="4dp"/>
            <TextView android:id="@+id/gemsTop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#1cb0f6" android:textSize="14sp" android:textStyle="bold" android:layout_marginLeft="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginLeft="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="H" android:textColor="#ff4b4b" android:textSize="14sp" android:textStyle="bold" android:background="#ffe6e6" android:paddingLeft="7dp" android:paddingRight="7dp" android:paddingTop="4dp" android:paddingBottom="4dp"/>
            <TextView android:id="@+id/heartsTop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textColor="#ff4b4b" android:textSize="14sp" android:textStyle="bold" android:layout_marginLeft="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Section banner — blue -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#1cb0f6" android:padding="14dp" android:layout_margin="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SECTION 1  •  UNIT 1" android:textColor="#ffffff" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08"/>
        <TextView android:id="@+id/bannerTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quest Path — Tap a node to start" android:textColor="#ffffff" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/bannerSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RANK E -> S  •  LV x 10 XP  •  Boss chests glow" android:textColor="#ffffff" android:alpha="0.9" android:textSize="11sp" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">

    <!-- Hero strip — XP + ladder + badges compact -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#ffffff" android:layout_marginLeft="12dp" android:layout_marginRight="12dp" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/rankBadge" android:layout_width="40dp" android:layout_height="40dp" android:background="#5a5a6a" android:text="E" android:textColor="#ffffff" android:textSize="18sp" android:textStyle="bold" android:gravity="center"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="10dp">
                <TextView android:id="@+id/heroLevel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LV.1  •  0 XP" android:textColor="#1a1433" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:id="@+id/rankLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="E - Novice" android:textColor="#777777" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/statQuests" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#1a1433" android:textSize="14sp" android:textStyle="bold" android:layout_gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DONE" android:textColor="#999999" android:textSize="8sp" android:layout_gravity="center"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginLeft="12dp">
                <TextView android:id="@+id/statXp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#1a1433" android:textSize="14sp" android:textStyle="bold" android:layout_gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XP" android:textColor="#999999" android:textSize="8sp" android:layout_gravity="center"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginLeft="12dp">
                <TextView android:id="@+id/statRank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="E" android:textColor="#1a1433" android:textSize="14sp" android:textStyle="bold" android:layout_gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RANK" android:textColor="#999999" android:textSize="8sp" android:layout_gravity="center"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/xpLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 100  ->  D" android:textColor="#1cb0f6" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="10dp"/>
        <ProgressBar android:id="@+id/xpBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:max="100" android:progress="6" android:layout_marginTop="4dp"/>
        <LinearLayout android:id="@+id/ladderRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"/>
        <LinearLayout android:id="@+id/badgesRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Add quest -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#ffffff" android:layout_marginLeft="12dp" android:layout_marginRight="12dp" android:layout_marginTop="12dp" android:padding="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEW QUEST  •  EXP = LV x 10" android:textColor="#1a1433" android:textSize="9sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <EditText android:id="@+id/questInput" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="#f0f4ff" android:hint="Enter quest..." android:textColor="#1a1433" android:textColorHint="#999999" android:paddingLeft="12dp" android:paddingRight="12dp" android:textSize="14sp" android:singleLine="true" android:inputType="text"/>
            <TextView android:id="@+id/addBtn" android:layout_width="wrap_content" android:layout_height="44dp" android:text="+ ADD" android:textColor="#ffffff" android:background="#58cc02" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:paddingLeft="16dp" android:paddingRight="16dp" android:layout_marginLeft="8dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAT" android:textColor="#777777" android:textSize="8sp" android:textStyle="bold" android:layout_gravity="center_vertical"/>
            <TextView android:id="@+id/catStudy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STUDY" android:textSize="8sp" android:textStyle="bold" android:background="#58cc02" android:textColor="#ffffff" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginLeft="8dp" android:clickable="true"/>
            <TextView android:id="@+id/catCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CODE" android:textSize="8sp" android:background="#e5e5e5" android:textColor="#777777" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginLeft="6dp" android:clickable="true"/>
            <TextView android:id="@+id/catHealth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HEALTH" android:textSize="8sp" android:background="#e5e5e5" android:textColor="#777777" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginLeft="6dp" android:clickable="true"/>
            <TextView android:id="@+id/catLife" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIFE" android:textSize="8sp" android:background="#e5e5e5" android:textColor="#777777" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginLeft="6dp" android:clickable="true"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DIFFICULTY  1 Easy  ->  10 Boss (100 XP)" android:textColor="#777777" android:textSize="9sp" android:layout_marginTop="10dp"/>
        <SeekBar android:id="@+id/diffSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="9" android:progress="4" android:layout_marginTop="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:id="@+id/diffLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LV. 5  ->  +50 XP" android:textColor="#ffffff" android:background="#1cb0f6" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textSize="11sp" android:textStyle="bold"/>
            <TextView android:id="@+id/diffHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Balanced" android:textColor="#777777" android:textSize="10sp" android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/diffDots" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Filters -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_margin="12dp">
        <TextView android:id="@+id/tabAll" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="ALL" android:textSize="10sp" android:textStyle="bold" android:background="#1cb0f6" android:textColor="#ffffff" android:gravity="center" android:clickable="true"/>
        <TextView android:id="@+id/tabActive" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="ACTIVE" android:textSize="10sp" android:background="#ffffff" android:textColor="#777777" android:gravity="center" android:layout_marginLeft="6dp" android:clickable="true"/>
        <TextView android:id="@+id/tabDone" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="CLEARED" android:textSize="10sp" android:background="#ffffff" android:textColor="#777777" android:gravity="center" android:layout_marginLeft="6dp" android:clickable="true"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginLeft="12dp" android:layout_marginRight="12dp" android:layout_marginBottom="8dp">
        <TextView android:id="@+id/countActive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 ACTIVE" android:textColor="#1cb0f6" android:textSize="9sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  |  " android:textColor="#cccccc" android:textSize="9sp"/>
        <TextView android:id="@+id/countDone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 DONE" android:textColor="#777777" android:textSize="9sp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/clearBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLEAR DONE" android:textColor="#ff4b4b" android:textSize="9sp" android:textStyle="bold" android:clickable="true"/>
    </LinearLayout>

    <!-- Winding path -->
    <LinearLayout android:id="@+id/pathContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Boss nodes (LV 9-10) are chests with bonus glow" android:textColor="#999999" android:textSize="9sp" android:layout_marginLeft="12dp" android:layout_marginTop="4dp"/>

    </LinearLayout>
    </ScrollView>

    <!-- Bottom nav — Duolingo-like 5 items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#ffffff"
        android:orientation="horizontal"
        android:elevation="8dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="H" android:textColor="#58cc02" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PATH" android:textColor="#58cc02" android:textSize="8sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P" android:textColor="#cccccc" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRACTICE" android:textColor="#cccccc" android:textSize="8sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="#cccccc" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEAGUE" android:textColor="#cccccc" android:textSize="8sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="#cccccc" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHOP" android:textColor="#cccccc" android:textSize="8sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="U" android:textColor="#cccccc" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOU" android:textColor="#cccccc" android:textSize="8sp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
