<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#f4e4bc"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <TextView android:id="@+id/ring" android:layout_width="36dp" android:layout_height="36dp" android:text="○" android:gravity="center" android:textColor="#1a1433" android:textSize="22sp" android:background="#ffffff"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="10dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quest title" android:textColor="#1a1433" android:textSize="14sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/diffPill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LV.5" android:textSize="9sp" android:textStyle="bold" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            <TextView android:id="@+id/xpPill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+50 XP" android:textSize="9sp" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginLeft="6dp"/>
            <TextView android:id="@+id/catPill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CODE" android:textSize="8sp" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginLeft="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/deleteBtn" android:layout_width="36dp" android:layout_height="36dp" android:text="x" android:gravity="center" android:textColor="#cc3333" android:textSize="16sp" android:background="#1a1433"/>

</LinearLayout>
