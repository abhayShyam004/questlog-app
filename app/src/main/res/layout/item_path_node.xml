<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <FrameLayout android:id="@+id/nodeFrame" android:layout_width="78dp" android:layout_height="78dp">

        <View android:layout_width="78dp" android:layout_height="78dp" android:background="@drawable/bg_circle_locked" android:alpha="0.0"/>

        <!-- Main circle -->
        <LinearLayout android:id="@+id/nodeCircle" android:layout_width="72dp" android:layout_height="72dp" android:orientation="vertical" android:gravity="center" android:layout_gravity="center">

            <ImageView android:id="@+id/nodeIcon" android:layout_width="32dp" android:layout_height="32dp"/>

        </LinearLayout>

        <!-- XP pop -->
        <TextView android:id="@+id/xpPop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+50 XP" android:textColor="#58cc02" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" android:layout_gravity="top|center_horizontal" android:layout_marginTop="2dp"/>

    </FrameLayout>

    <!-- Pill -->
    <TextView android:id="@+id/nodeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LV.5 +50 XP" android:textSize="9sp" android:textStyle="bold" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="6dp"/>

    <TextView android:id="@+id/nodeTitle" android:layout_width="220dp" android:layout_height="wrap_content" android:text="Quest title" android:textColor="#1a1433" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="4dp"/>

    <!-- dotted connector -->
    <View android:id="@+id/connector" android:layout_width="4dp" android:layout_height="22dp" android:background="#e5e5e5" android:layout_marginTop="6dp"/>

</LinearLayout>
